{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Checkpoint",
  "description": "A single checkpoint in a reasoning trace (Section 3.2)",
  "type": "object",
  "required": ["sample_id", "checkpoint_id", "t", "checkpoint_type", "content"],
  "properties": {
    "sample_id": {
      "type": "string",
      "description": "Unique sample identifier"
    },
    "checkpoint_id": {
      "type": "string",
      "description": "Unique checkpoint identifier, format: {sample_id}::cp::{t:04d}"
    },
    "t": {
      "type": "integer",
      "minimum": 1,
      "description": "Checkpoint sequence number (1-indexed)"
    },
    "checkpoint_type": {
      "type": "string",
      "enum": [
        "column_reference",
        "predicate_binding",
        "schema_linking",
        "aggregation_or_ordering",
        "other"
      ],
      "description": "Type of reasoning step"
    },
    "content": {
      "description": "Checkpoint content (SQL fragment, reasoning step, etc.)",
      "anyOf": [
        { "type": "object" },
        { "type": "string" },
        { "type": "array" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "source_span": {
      "type": ["object", "null"],
      "description": "Source span in original trace (optional)"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "default": {}
    }
  },
  "additionalProperties": false
}
